# ─── LLM PROVIDER ────────────────────────────────────────────────────────────
# Switch between providers without any code changes.
# gemini = development on Windows (fast, cheap, cloud)
# ollama = demo and GCP production (local, sovereign, no external calls)
LLM_PROVIDER=gemini

# Google Gemini (development only — register free at aistudio.google.com)
# Free tier varies by model. If GEMINI_MODEL hits a daily-quota error (HTTP 429
# "PerDayPerProjectPerModel-FreeTier"), switch to a different model on the next line.
# Known-good free-tier choices in early 2026:
#   gemini-2.0-flash         (default; 1,500 req/day)
#   gemini-2.0-flash-lite    (3,000 req/day)
#   gemini-2.5-flash-lite    (works when 2.0 quotas are exhausted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama (demo/production — only needed when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Devil's Advocate uses a slightly more creative model
OLLAMA_DEVIL_MODEL=qwen2.5:7b

# ─── GEOSPATIAL ──────────────────────────────────────────────────────────────
# Copernicus / Sentinel Hub — free account at dataspace.copernicus.eu
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# ─── OSINT ────────────────────────────────────────────────────────────────────
# Telegram — register app at my.telegram.org (free)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# AISStream — free tier at aisstream.io
AISSTREAM_API_KEY=

# ─── GRAPH DATABASE ───────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_neo4j_password

# ─── APPLICATION ──────────────────────────────────────────────────────────────
DAMOCLES_ENV=development          # development | production
LOG_LEVEL=INFO
DEMO_MODE=true                    # true = uses seeded data, false = live APIs
GCP_PROJECT_ID=
